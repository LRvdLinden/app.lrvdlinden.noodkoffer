            "value": "Zet apparaten uit, zodat ze niet allemaal tegelijk aanslaan als de stroom terugkomt."
          }
        }
      }
    },
    "Sync now": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu synchroniseren"
          }
        }
      }
    },
    "Synced %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesynchroniseerd %@"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met synchroniseren…"
          }
        }
      }
    },
    "The app calculates how much water, food and cash you need.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app berekent hoeveel water, eten en contant geld je nodig hebt."
          }
        }
      }
    },
    "The password is too long.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord is te lang."
          }
        }
      }
    },
    "The password needs at least 8 characters.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord moet minstens 8 tekens hebben."
          }
        }
      }
    },
    "The shared kit replaces the kit on this device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gedeelde pakket komt in de plaats van het pakket op dit apparaat."
          }
        }
      }
    },
    "These items do not count towards your kit. Tap one to use it again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze items tellen niet mee in je pakket. Tik erop om ze weer te gebruiken."
          }
        }
      }
    },
    "They keep their account and start again with their own household.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diegene houdt het account en begint opnieuw met een eigen gezin."
          }
        }
      }
    },
    "They receive an email and see the invitation in the app after signing in with this address.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diegene krijgt een mail en ziet de uitnodiging in de app na het inloggen met dit adres."
          }
        }
      }
    },
    "This invitation is no longer valid.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze uitnodiging is niet meer geldig."
          }
        }
      }
    },
    "This person is already in your household.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze persoon zit al in je gezin."
          }
        }
      }
    },
    "This postcode was not found.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze postcode is niet gevonden."
          }
        }
      }
    },
    "Tick an item when you have bought it: it moves into your kit.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink een item af als je het gekocht hebt: het gaat dan je pakket in."
          }
        }
      }
    },
    "Time for your half-yearly check": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd voor je halfjaarlijkse check"
          }
        }
      }
    },
    "Time for your half-yearly check. Go through your kit in a few minutes.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd voor je halfjaarlijkse check. Loop je noodpakket in een paar minuten na."
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag"
          }
        }
      }
    },
    "Together with your household": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samen met je gezin"
          }
        }
      }
    },
    "Toilet paper and bin bags": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wc-papier en vuilniszakken"
          }
        }
      }
    },
    "Too many attempts. Please try again later.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Probeer het later opnieuw."
          }
        }
      }
    },
    "Torch": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaklamp"
          }
        }
      }
    },
    "Touch ID": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID"
          }
        }
      }
    },
    "Tune a battery or wind-up radio to it now.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een radio op batterijen of met opwinder er nu alvast op in."
          }
        }
      }
    },
    "Type the numbers under the barcode instead.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ in plaats daarvan de cijfers onder de barcode."
          }
        }
      }
    },
    "Unit": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenheid"
          }
        }
      }
    },
    "Unknown product": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbekend product"
          }
        }
      }
    },
    "Unlock Noodpakket.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel Noodpakket."
          }
        }
      }
    },
    "Unlock with %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel met %@"
          }
        }
      }
    },
    "Use a torch rather than candles, and never leave candles unattended.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik liever een zaklamp dan kaarsen, en laat kaarsen nooit alleen."
          }
        }
      }
    },
    "Use at least one letter and one number in your password.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik minstens één letter en één cijfer in je wachtwoord."
          }
        }
      }
    },
    "Use water sparingly; wet wipes and hand gel help with hygiene.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga zuinig om met water; vochtige doekjes en handgel helpen bij de hygiëne."
          }
        }
      }
    },
    "Use your printed emergency plan: meeting point and phone numbers are on it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je geprinte noodplan: daar staan het verzamelpunt en de telefoonnummers op."
          }
        }
      }
    },
    "Use your stored drinking water: 3 litres per person per day.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je voorraad drinkwater: 3 liter per persoon per dag."
          }
        }
      }
    },
    "Version 1.0": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versie 1.0"
          }
        }
      }
    },
    "Vet": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dierenarts"
          }
        }
      }
    },
    "Warmth and shelter": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmte en beschutting"
          }
        }
      }
    },
    "Warn the people around you, such as neighbours and visitors.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuw de mensen om je heen, zoals buren en bezoekers."
          }
        }
      }
    },
    "Water and food": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Water en eten"
          }
        }
      }
    },
    "Water outage · %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterstoring · %@"
          }
        }
      }
    },
    "Water, gas and electricity": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Water, gas en stroom"
          }
        }
      }
    },
    "We sent a link to %@. Tap it to activate your account, then sign in here.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben een link gestuurd naar %@. Tik erop om je account te activeren en log daarna hier in."
          }
        }
      }
    },
    "Website": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Website"
          }
        }
      }
    },
    "What to do during a power cut, NL-Alert and more": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat te doen bij stroomuitval, NL-Alert en meer"
          }
        }
      }
    },
    "What to do when…": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat te doen bij…"
          }
        }
      }
    },
    "What's new": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is nieuw"
          }
        }
      }
    },
    "When the tap works again, follow the advice of your water company, for example boiling water first.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt de kraan weer, volg dan het advies van je drinkwaterbedrijf, bijvoorbeeld water eerst koken."
          }
        }
      }
    },
    "When you join, the shared kit replaces the kit on this device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je deel, dan komt het gedeelde pakket in de plaats van het pakket op dit apparaat."
          }
        }
      }
    },
    "Where do you live?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar woon je?"
          }
        }
      }
    },
    "Where the main tap, gas valve and fuse box are": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar de hoofdkraan, gaskraan en meterkast zitten"
          }
        }
      }
    },
    "Where you can go, for example family outside your region": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar je heen kunt, bijvoorbeeld familie buiten je regio"
          }
        }
      }
    },
    "Who": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie"
          }
        }
      }
    },
    "Who is in your household?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hoort bij je huishouden?"
          }
        }
      }
    },
    "Who picks up the children, who checks on the neighbours": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie haalt de kinderen op, wie kijkt bij de buren"
          }
        }
      }
    },
    "Widget for your home screen": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget voor je beginscherm"
          }
        }
      }
    },
    "With a free account everyone in your household sees the same kit and shopping list, also between iPhone and Android. An account is not required.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een gratis account ziet iedereen in je gezin hetzelfde pakket en dezelfde boodschappenlijst, ook tussen iPhone en Android. Een account is niet verplicht."
          }
        }
      }
    },
    "Within 30 days": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnen 30 dagen"
          }
        }
      }
    },
    "Work": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk"
          }
        }
      }
    },
    "Year": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaar"
          }
        }
      }
    },
    "You are the only member of this household.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent het enige lid van dit gezin."
          }
        }
      }
    },
    "You cannot invite yourself.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt jezelf niet uitnodigen."
          }
        }
      }
    },
    "You get a reminder on this day to go through your kit.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze dag krijg je een herinnering om je pakket na te lopen."
          }
        }
      }
    },
    "You have been signed out. Please sign in again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent uitgelogd. Log opnieuw in."
          }
        }
      }
    },
    "You keep the kit on this device and continue with your own household.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je houdt het pakket op dit apparaat en gaat verder met een eigen gezin."
          }
        }
      }
    },
    "Your account is deleted immediately. If you are the last member of your household, the shared data is deleted too. The kit on this device stays.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account wordt direct verwijderd. Ben je de laatste van je gezin, dan worden ook de gedeelde gegevens verwijderd. Het pakket op dit apparaat blijft staan."
          }
        }
      }
    },
    "Your kit is complete": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je noodpakket is compleet"
          }
        }
      }
    },
    "Your kit is complete. Items that run out or expire show up here.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pakket is compleet. Wat opraakt of verloopt, komt hier te staan."
          }
        }
      }
    },
    "Your kit is shared with everyone in your household.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pakket wordt gedeeld met iedereen in je gezin."
          }
        }
      }
    },
    "Your municipality: often 14 plus the area code (for example 14 070 in The Hague).": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gemeente: vaak 14 plus het netnummer (bijvoorbeeld 14 070 in Den Haag)."
          }
        }
      }
    },
    "Your own contacts": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen contacten"
          }
        }
      }
    },
    "Your own medicines for at least 3 days, and a list of them.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen medicijnen voor minstens 3 dagen, en een lijst ervan."
          }
        }
      }
    },
    "Your postcode is only used to look up these numbers and is not stored on our server.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je postcode wordt alleen gebruikt om deze nummers op te zoeken en niet op onze server bewaard."
          }
        }
      }
    },
    "Your regional broadcaster and its FM frequency": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je regionale omroep en de FM-frequentie"
          }
        }
      }
    },
    "complete": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "compleet"
          }
        }
      }
    },
    "lrvdlinden.app": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "lrvdlinden.app"
          }
        }
      }
    },
    "no own contacts yet": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "nog geen eigen contacten"
          }
        }
      }
    },
    "passcode": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "toegangscode"
          }
        }
      }
    },
    "€70 per adult and €30 per child, in small notes.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "€ 70 per volwassene en € 30 per kind, in kleine coupures."
          }
        }
      }
    }
