    "0900-8844: police, when it is not urgent.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0900-8844: politie, als het geen spoed is."
          }
        }
      }
    },
    "112 · Police 0900-8844 · Made with Noodpakket": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "112 · Politie 0900-8844 · Gemaakt met Noodpakket"
          }
        }
      }
    },
    "112: emergencies where every second counts.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "112: spoed, als elke seconde telt."
          }
        }
      }
    },
    "3 litres per person per day, for the number of days you set.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 liter per persoon per dag, voor het aantal dagen dat je instelt."
          }
        }
      }
    },
    "3 months": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 maanden"
