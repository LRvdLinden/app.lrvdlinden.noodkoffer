      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg toe"
          }
        }
      }
    },
    "Add expiry dates to water, food, batteries and medicines in your kit.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg houdbaarheidsdatums toe aan water, eten, batterijen en medicijnen in je pakket."
          }
        }
      }
    },
