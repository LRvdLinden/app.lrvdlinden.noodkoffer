      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "6 maanden"
          }
        }
      }
    },
    "A torch per household, preferably a wind-up or battery model.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zaklamp per huishouden, liefst een opwind- of batterijmodel."
