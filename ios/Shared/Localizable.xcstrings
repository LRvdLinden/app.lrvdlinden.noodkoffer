    },
    "112 · Police 0900-8844 · Made with Noodpakket": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "112 · Politie 0900-8844 · Gemaakt met Noodpakket"
          }
        }
      }
    },
    "112, your municipality, the emergency broadcaster, your GP and family, ready to call and to print.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "112, je gemeente, de rampenzender, je huisarts en familie: direct te bellen en te printen."
          }
        }
      }
    },
    "112: emergencies where every second counts.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "112: spoed, als elke seconde telt."
          }
        }
      }
    },
    "113 Zelfmoordpreventie, day and night": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "113 Zelfmoordpreventie, dag en nacht"
          }
        }
      }
    },
    "3 litres per person per day, for the number of days you set.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 liter per persoon per dag, voor het aantal dagen dat je instelt."
          }
        }
      }
    },
