    "Agree on this together and keep a printed copy with your kit. Phones may not work during an emergency.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek dit samen af en bewaar een geprinte versie bij je noodpakket. In een noodsituatie werkt je telefoon misschien niet."
          }
        }
      }
    },
