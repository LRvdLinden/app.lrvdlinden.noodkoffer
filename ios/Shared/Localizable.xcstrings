          "stringUnit": {
            "state": "translated",
            "value": "Verloopt op"
          }
        }
      }
    },
    "Expires today. Replace it in your emergency kit.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verloopt vandaag. Vervang het in je noodpakket."
          }
        }
      }
    },
